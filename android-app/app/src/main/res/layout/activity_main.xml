<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- मुख्य शीर्षक -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎓 अनंत अभ्यास एडमिन"
            android:textColor="#F8FAFC"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="गेटवे नंबर: 9664006651 (Jio Live)"
            android:textColor="#4ADE80"
            android:textSize="14sp" />

        <!-- 📲 पेरेंट्स को WhatsApp लिंक भेजने का मुख्य बटन -->
        <Button
            android:id="@+id/btnShareWhatsApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#25D366"
            android:padding="12dp"
            android:text="📲 पेरेंट्स को WhatsApp लिंक शेयर करें"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- लाइव मेट्रिक्स ग्रिड -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:columnCount="2"
            android:rowCount="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="#1E293B"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView android:text="कुल सक्रिय छात्र" android:textColor="#94A3B8" android:textSize="12sp"/>
                <TextView android:id="@+id/tvTotalActive" android:text="0" android:textColor="#38BDF8" android:textSize="22sp" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="#1E293B"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView android:text="नए जुड़े बच्चे" android:textColor="#94A3B8" android:textSize="12sp"/>
                <TextView android:id="@+id/tvNewJoined" android:text="0" android:textColor="#4ADE80" android:textSize="22sp" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="#1E293B"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView android:text="रेफरल पूरे हुए" android:textColor="#94A3B8" android:textSize="12sp"/>
                <TextView android:id="@+id/tvReferralCompleted" android:text="0" android:textColor="#A855F7" android:textSize="22sp" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="#1E293B"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView android:text="नए रेफरल" android:textColor="#94A3B8" android:textSize="12sp"/>
                <TextView android:id="@+id/tvNewReferrals" android:text="0" android:textColor="#FACC15" android:textSize="22sp" android:textStyle="bold"/>
            </LinearLayout>
        </GridLayout>

        <!-- 360° छात्र कुंडली सर्च -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="🔍 360° छात्र कुंडली सर्च"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etSearchKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1E293B"
            android:hint="UID या फोन नंबर दर्ज करें"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2563EB"
            android:text="कुंडली निकालें"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <!-- कुंडली रिजल्ट कार्ड -->
        <LinearLayout
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 छात्र कुंडली विवरण"
                android:textColor="#38BDF8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvKundaliData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="#E2E8F0"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 1-टैप कॉन्टैक्ट सिंक -->
        <Button
            android:id="@+id/btnSyncContacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#10B981"
            android:text="🔄 फोन के कॉन्टैक्ट्स सर्वर पर सुरक्षित सिंक करें"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
